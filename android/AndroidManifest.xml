<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.oneo.nsgo.servicedemo"
    android:versionCode="2"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <!-- 网络与剪贴板基础权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 前台常驻服务权限与通知栏权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="NSGo 前台服务"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:extractNativeLibs="true">

        <!-- 外层宿主工程自己的 MainActivity -->
        <activity
            android:name="dev.oneo.nsgo.servicedemo.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 外层宿主工程自己的前台常驻 Service -->
        <service
            android:name="dev.oneo.nsgo.servicedemo.ForegroundGoService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- NSGo .aar 所需的剪贴板 Provider -->
        <provider
            android:name="dev.oneo.nsgo.ClipProvider"
            android:authorities="dev.oneo.nsgo.servicedemo.nsgo.clip"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
